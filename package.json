{
  "name": "browser-smash",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start": "vite --host 0.0.0.0",
    "build": "vite build",
    "validate:assets": "node scripts/validate-assets.mjs",
    "validate:animations": "node scripts/validate-animations.mjs",
    "test:combat": "node scripts/test-combat.mjs",
    "test:flight": "node scripts/test-flight.mjs",
    "test:flight-live": "bash scripts/run-browser-test.sh scripts/test-flight-live.mjs",
    "test:locomotion": "node scripts/test-locomotion.mjs",
    "test:worlds": "node scripts/test-worlds.mjs",
    "test:hogwarts": "bash scripts/run-browser-test.sh scripts/test-hogwarts.mjs",
    "test:worlds:browser": "bash scripts/run-browser-test.sh scripts/test-worlds-browser.mjs",
    "test:explore": "bash scripts/run-browser-test.sh scripts/test-explore.mjs",
    "test:mechanics": "bash scripts/run-browser-test.sh scripts/test-mechanics.mjs",
    "test:feel": "bash scripts/run-browser-test.sh scripts/test-stage-feel.mjs",
    "test:gameplay": "bash scripts/run-browser-test.sh scripts/test-gameplay.mjs",
    "test:cpu-skill": "node scripts/test-cpu-skill.mjs",
    "test:smoke": "bash scripts/run-browser-test.sh scripts/browser-smoke.mjs",
    "test:arena-switch": "bash scripts/run-browser-test.sh scripts/test-arena-switch.mjs",
    "test:combat-damage": "bash scripts/run-browser-test.sh scripts/test-combat-damage.mjs",
    "capture:deathstar": "bash scripts/run-browser-test.sh scripts/capture-deathstar.mjs",
    "audit:roster": "bash scripts/run-browser-test.sh scripts/audit-roster.mjs",
    "audit:rigs": "node scripts/audit-rig-families.mjs",
    "build:rig-batch": "node scripts/build-rig-family-batch.mjs",
    "test:rig-batch": "node scripts/verify-rig-family-batch.mjs",
    "test:rig-solo": "node scripts/verify-solo-rig-lanes.mjs",
    "report:rig-acceptance": "node scripts/report-rig-acceptance.mjs",
    "audit:hd-roster": "node scripts/audit-hd-roster.mjs",
    "report:roster": "node scripts/report-roster-quality.mjs > docs/CHARACTER_ROSTER_QUALITY_AUDIT.md.tmp && mv docs/CHARACTER_ROSTER_QUALITY_AUDIT.md.tmp docs/CHARACTER_ROSTER_QUALITY_AUDIT.md",
    "measure:bodies": "node scripts/measure-roster-bodies.mjs > artifacts/roster-bodies.json",
    "measure:model": "node scripts/measure-model-refinement.mjs > artifacts/model-quality.json",
    "gate:model": "node scripts/measure-model-refinement.mjs --gate",
    "test:rig": "node scripts/test-rig.mjs",
    "test:iron-spider": "bash scripts/run-browser-test.sh scripts/test-iron-spider.mjs",
    "test:movesets": "bash scripts/run-browser-test.sh scripts/test-movesets.mjs",
    "test:animation": "node scripts/test-animation-pipeline.mjs",
    "test:animation-coverage": "node scripts/test-animation-coverage.mjs",
    "test:attack-vocabulary": "node scripts/test-attack-vocabulary.mjs",
    "test:motion": "node scripts/test-motion-style.mjs",
    "test:rig-architecture": "node scripts/test-rig-architecture.mjs",
    "test:head-bone": "bash scripts/run-browser-test.sh scripts/verify-head-bone.mjs",
    "test:controller-attacks": "bash scripts/run-browser-test.sh scripts/verify-controller-attacks.mjs",
    "test:keyboard-combat": "bash scripts/run-browser-test.sh scripts/verify-naruto-combat.mjs",
    "test:equipment": "node scripts/test-equipment-state.mjs",
    "test:projectile": "node scripts/test-projectile-origin.mjs",
    "test:abilities": "node scripts/test-abilities.mjs",
    "test:camera": "node scripts/test-camera.mjs",
    "test:modes": "node scripts/test-modes.mjs",
    "test:audio": "node scripts/test-audio.mjs",
    "test:destruction": "node scripts/test-destruction.mjs",
    "test:presets": "node scripts/test-graphics-presets.mjs",
    "test:governor": "node scripts/test-performance-governor.mjs",
    "test:textures": "node scripts/test-texture-ownership.mjs",
    "test:ai": "node scripts/test-ai-brain.mjs",
    "test:tournament": "node scripts/test-tournament.mjs",
    "probe:audit": "bash scripts/run-browser-test.sh scripts/probe-performance-audit.mjs",
    "probe:presets": "bash scripts/run-browser-test.sh scripts/probe-presets.mjs",
    "test:kaze": "node scripts/test-kaze-clips.mjs",
    "make:rig-fixture": "node scripts/make-rig-fixture.mjs",
    "install:blender": "bash scripts/install-blender.sh",
    "build:fighter": "bash scripts/blender.sh -b --python assets/blender/build_anime_fighter.py -- --out public/models/characters/kaze/kaze.glb",
    "inspect:glb": "node scripts/inspect-character-glb.mjs public/models/characters/kaze/kaze.glb",
    "build:roster": "bash scripts/blender.sh -b --python assets/blender/build_roster_models.py -- --out-dir public/models/characters/original",
    "build:roster-fighters": "bash scripts/blender.sh -b --python assets/blender/build_roster_fighters.py -- --out-dir public/models/characters/roster --group all",
    "test:roster-models": "node scripts/test-roster-models.mjs",
    "probe:bodies": "bash scripts/run-browser-test.sh scripts/probe-character-bodies.mjs",
    "test:ingest-licence": "node scripts/test-ingest-licence-metadata.mjs",
    "test:fetch-token": "node scripts/test-fetch-token.mjs",
    "test:geometry": "bash scripts/blender.sh -b --python scripts/test-geometry-kernel.py",
    "test:model-import": "node scripts/test-model-import.mjs",
    "test:model-import:browser": "bash scripts/run-browser-test.sh scripts/test-model-import-browser.mjs",
    "test:rematch": "bash scripts/run-browser-test.sh scripts/test-rematch-textures.mjs",
    "accept:lasso": "bash scripts/run-browser-test.sh scripts/accept-lasso.mjs",
    "capture:slice": "bash scripts/run-browser-test.sh scripts/capture-slice.mjs",
    "capture:closeups": "bash scripts/run-browser-test.sh scripts/capture-closeups.mjs",
    "report:animation-paths": "node scripts/report-animation-paths.mjs --write",
    "test:naruto-signatures": "bash scripts/run-browser-test.sh scripts/verify-naruto-signatures.mjs",
    "test:bespoke-animations": "bash scripts/run-browser-test.sh scripts/verify-bespoke-animations.mjs",
    "test:transformation": "bash scripts/run-browser-test.sh scripts/verify-transformation.mjs",
    "audit:exploration": "bash scripts/run-browser-test.sh scripts/audit-arena-exploration.mjs"
  },
  "devDependencies": {
    "vite": "^6.4.1"
  },
  "dependencies": {
    "three": "^0.152.2"
  }
}
